#include "./helper_keypos_34keys.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25 // default 10
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUE  1
#define SYM  2
#define NAV  3
#define TRI  4

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH1 LH0 RH0 RH1

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    behaviors {
        hml: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        sk_shft: sticky_shift_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk RSHIFT>, <&caps_word>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // Tab that becomes Shift+Tab while left Cmd/Ctrl is held, so the
        // right-hand tab combo cycles windows/tabs backwards. keep-mods
        // keeps Cmd/Ctrl active so the OS sees the full chord.
        tab_rev: tab_reverse_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp LS(TAB)>;

            mods = <(MOD_LGUI | MOD_LCTL)>;
            keep-mods = <(MOD_LGUI | MOD_LCTL)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
            key-positions = <LT3 LT2>;
            bindings = <&kp ESC>;
        };

        combo_bksp {
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
            key-positions = <RT3 RT2>;
            bindings = <&kp BSPC>;
        };

        // Low prior-idle so these fire mid-word/mid-sentence; the tight
        // term is what guards against "sd"/"kl" rolls while typing.
        combo_sticky_shift_l {
            timeout-ms = <25>;
            require-prior-idle-ms = <50>;
            key-positions = <LM3 LM2>;
            layers = <BASE NUE>;
            bindings = <&sk_shft>;
        };

        combo_sticky_shift_r {
            timeout-ms = <25>;
            require-prior-idle-ms = <50>;
            key-positions = <RM2 RM3>;
            layers = <BASE NUE>;
            bindings = <&sk_shft>;
        };

        // Tab on bottom-row index+middle chords. Left = Tab; right morphs
        // to Shift+Tab under left Cmd/Ctrl (reverse cycling). Low prior-idle
        // so repeated chords keep firing while cycling through windows.
        combo_tab_l {
            timeout-ms = <25>;
            require-prior-idle-ms = <50>;
            key-positions = <LB2 LB1>;
            layers = <BASE NUE>;
            bindings = <&kp TAB>;
        };

        combo_tab_r {
            timeout-ms = <25>;
            require-prior-idle-ms = <50>;
            key-positions = <RB1 RB2>;
            layers = <BASE NUE>;
            bindings = <&tab_rev>;
        };

        combo_dongle_boot {
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
            key-positions = <LM3 LM2>;
            layers = <TRI>;
            bindings = <&bootloader>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <TRI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q   &kp W          &kp E         &kp R         &kp T       &kp Y     &kp U        &kp I         &kp O          &kp P
&kp A   &hml LALT S    &hml LCTRL D  &hml LGUI F   &kp G       &kp H     &hmr RGUI J  &hmr RCTRL K  &hmr RALT L    &kp SQT
&kp Z   &kp X          &kp C         &kp V         &kp B       &kp N     &kp M        &kp COMMA     &kp DOT        &kp FSLH
                        &none           &lt SYM SPACE             &lt NAV RET  &none
            >;
        };

        hands_down_nue {
            label = "NUE";
            bindings = <
&kp W   &kp F          &kp M         &kp P         &kp V       &kp J      &kp DOT      &kp Q         &kp SQT        &kp Z
&kp R   &hml LALT S    &hml LCTRL N  &hml LGUI T   &kp B       &kp COMMA  &hmr RGUI A  &hmr RCTRL E  &hmr RALT I    &kp H
&kp X   &kp C          &kp L         &kp D         &kp G       &kp UNDER  &kp U        &kp O         &kp Y          &kp K
                     &none            &lt SYM SPACE                  &lt NAV RET  &none
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&kp EXCL  &kp AT     &kp HASH  &kp DLLR   &kp PRCNT     &kp CARET  &kp LBKT  &kp RBKT  &kp BSLH   &kp PIPE
&kp SEMI  &kp COLON  &kp PLUS  &kp EQUAL  &kp MINUS     &kp AMPS   &kp LBRC  &kp RBRC  &kp GRAVE  &kp TILDE
&kp DOT   &kp FSLH   &kp LT    &kp GT     &kp UNDER     &kp STAR   &kp LPAR  &kp RPAR  &kp DOT    &kp FSLH
                     &trans    &kp LGUI                 &trans     &trans
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&none   &kp N7  &kp N8  &kp N9  &kp C_BRI_UP    &none     &kp C_VOL_DN    &kp C_VOL_UP  &kp C_MUTE  &none
&kp N0  &kp N4  &kp N5  &kp N6  &kp C_BRI_DN    &kp LEFT  &kp DOWN        &kp UP        &kp RIGHT   &none
&none   &kp N1  &kp N2  &kp N3  &none           &none     &msc SCRL_DOWN  &msc SCRL_UP  &none       &none
                &kp N0  &lt SYM SPACE           &trans    &trans
            >;
        };

        adjust_layer {
            label = "TRI";
            bindings = <
&trans   &bt BT_CLR    &out OUT_TOG  &trans        &trans     &kp F12  &kp F7  &kp F8  &kp F9  &to BASE
&none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans     &kp F11  &kp F4  &kp F5  &kp F6  &to NUE
&trans   &trans        &trans        &trans        &trans     &kp F10  &kp F1  &kp F2  &kp F3  &to NAV
                       &trans        &trans                   &trans   &trans
            >;
        };
    };
};
